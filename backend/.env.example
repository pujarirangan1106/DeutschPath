# =============================================================================
# DeutschPath — AI Provider Configuration
# =============================================================================
#
# DeutschPath supports two AI backends. You can use either or both.
# The active provider is selected by the PROVIDER variable (see bottom).
#
# ── PROVIDER SELECTION LOGIC ─────────────────────────────────────────────────
#
#   PROVIDER=gemini   → always use Gemini regardless of other keys
#   PROVIDER=openai   → always use the OpenAI-compatible provider
#   (not set)         → auto-detect:
#                         · GEMINI_API_KEY set, API_KEY not set  → Gemini
#                         · API_KEY set, GEMINI_API_KEY not set  → OpenAI
#                         · Both set                             → Gemini wins
#
# You can also switch provider at runtime from Settings → AI Provider in the UI.
# =============================================================================


# ── PROVIDER 1: Gemini (Google) — default ─────────────────────────────────────
#
# Get a free key at https://aistudio.google.com/apikey
# Keys now start with AQ. (older AIza... keys are being deprecated)
#
# What Gemini covers:
#   · Text:          gemini-2.5-flash  (word analysis, grammar, chat, writing)
#   · Vision / OCR:  gemini-2.5-flash  (scanned PDF pages, region OCR)
#   · TTS:           gemini-2.5-flash-preview-tts  (neural voice, PCM16/WAV)
#   · Transcription: gemini-2.5-flash  (microphone input in Scenarios)
#
# Free-tier limits (as of mid-2026):
#   Text   — 10 RPM · 250,000 TPM · 250 req/day  (free)
#   TTS    — no free tier, always billed at paid rates
#
GEMINI_API_KEY=your-gemini-api-key-here


# ── PROVIDER 2: OpenAI-compatible ─────────────────────────────────────────────
#
# Works with OpenAI, Groq, GWDG SAIA, Ollama, LM Studio, or any provider
# that implements the OpenAI /v1/chat/completions API.
#
# What the OpenAI path covers:
#   · Text:          any chat-completions model  (word analysis, grammar, chat, writing)
#   · Vision / OCR:  requires a vision-capable model  (e.g. gpt-4o, qwen3.5-397b-a17b)
#                    — text-only models will fail on Book Reader OCR features
#   · TTS:           requires /v1/audio/speech support  (OpenAI tts-1 / tts-1-hd)
#                    — providers without TTS (Groq, Ollama, SAIA) will error on voice features
#   · Transcription: requires /v1/audio/transcriptions  (Whisper)
#                    — not available on all providers
#
# Provider examples:
#   OpenAI          API_BASE_URL=https://api.openai.com/v1          MODEL=gpt-4o-mini
#   Groq            API_BASE_URL=https://api.groq.com/openai/v1     MODEL=llama-3.3-70b-versatile
#   GWDG SAIA       API_BASE_URL=https://chat-ai.academiccloud.de/v1 MODEL=meta-llama-3.1-8b-instruct
#   Ollama (local)  API_BASE_URL=http://localhost:11434/v1           MODEL=llama3.2
#   LM Studio       API_BASE_URL=http://localhost:1234/v1            MODEL=<loaded model name>
#
#API_KEY=your-openai-compatible-key-here
#API_BASE_URL=https://api.openai.com/v1
#MODEL=gpt-4o-mini
#
# TTS settings (only used when PROVIDER=openai and the provider supports /v1/audio/speech)
#TTS_MODEL=tts-1
#TTS_VOICE=alloy


# ── Active provider ───────────────────────────────────────────────────────────
#
# Set explicitly to override auto-detection.
# Can also be changed at runtime via Settings → AI Provider in the app UI.
#
#PROVIDER=gemini


# ── App ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
